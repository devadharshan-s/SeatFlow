{
  "id": "bookmyshow",
  "realm": "bookmyshow",
  "enabled": true,
  "sslRequired": "external",
  "clients": [
    {
      "clientId": "bookmyshow-admin",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "change-me",
      "serviceAccountsEnabled": true,
      "publicClient": false,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "fullScopeAllowed": true
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "users": [
    {
      "username": "service-account-bookmyshow-admin",
      "enabled": true,
      "serviceAccountClientId": "bookmyshow-admin",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-users"
        ]
      }
    }
  ]
}
